# Database path
DB_PATH=data/walkforward.db

# Telegram credentials for auto_token.py alerts
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Agent firm LLM providers
# Z.ai (OpenAI-compatible endpoint)
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
AGENT_FIRM_MODEL=glm-5.2
AGENT_FIRM_ENABLED=true

# Provider routing (claude | zai | auto)
AGENT_FIRM_PROVIDER=zai
AGENT_FIRM_PROVIDER_ORDER=claude,zai   # only used when AGENT_FIRM_PROVIDER=auto

# Claude (via Claude Code Subscription CLI — no API key needed)
AGENT_FIRM_CLAUDE_MODEL=sonnet
AGENT_FIRM_CLAUDE_MAX_CONCURRENT=4
AGENT_FIRM_CLAUDE_MAX_CALLS_PER_DAY=200

# Circuit breaker (per provider)
AGENT_FIRM_CIRCUIT_FAILURES=3
AGENT_FIRM_CIRCUIT_COOLDOWN=30

# Quota-aware routing (RCA 2026-07-10): hold a session-limited provider out
# of rotation until its advertised reset time instead of re-probing it every
# circuit cooldown. All optional; defaults shown.
AGENT_FIRM_QUOTA_HOLD=true
AGENT_FIRM_QUOTA_RESET_BUFFER=60       # s past the advertised reset before retrying
AGENT_FIRM_QUOTA_FALLBACK_HOLD=900     # s to hold when no reset time was parseable
AGENT_FIRM_QUOTA_MAX_HOLD=21600        # s cap on any hold (mis-parse safety)
AGENT_FIRM_QUOTA_ALERTS=true
AGENT_FIRM_ALERT_MIN_INTERVAL=1800     # s dedupe window for repeatable alerts
AGENT_FIRM_QUOTA_REPEAT_THRESHOLD=3    # limit hits without recovery -> escalation alert

# Timeouts (seconds) — generic defaults; AGENT_FIRM_CLAUDE_* overrides optional
AGENT_FIRM_CONNECTION_TIMEOUT=10
AGENT_FIRM_READ_TIMEOUT=60
AGENT_FIRM_OVERALL_TIMEOUT=75

# Backups (scripts/db_backup.py, nightly via deploy/crontab)
# BACKUP_DIR=~/backups/idx-walkforward-5001

# --- Route authentication (security hardening) ---
# off (default, legacy) | shadow (log-only) | enforce (fail closed)
AUTH_MODE=off
# Comma-separated token lists per role; >=16 chars each. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN_ADMIN=
AUTH_TOKEN_OPERATOR=
AUTH_TOKEN_VIEWER=
AUTH_TOKEN_SCHEDULER=

# --- Release deployment (scripts/release.sh / scripts/rollback.sh) ---
# RELEASES_DIR=~/releases/idx-walkforward
# CURRENT_LINK=~/idx-walkforward-current
