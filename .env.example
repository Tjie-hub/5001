# Database path
DB_PATH=data/walkforward.db

# Flask session-cookie signing key. If unset, a random key is generated at
# each process start -- every gunicorn restart then invalidates all existing
# sessions. Set explicitly for a stable production deploy. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=

# Telegram credentials -- required at startup (validate_config()); the whole
# app refuses to boot without these. Used for every operational alert/report
# (scheduler job failures, EOD/premarket trade plans, forward-test summaries,
# etc.), not just auto_token.py.
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Shared secret Telegram must echo back in the X-Telegram-Bot-Api-Secret-Token
# header on every /telegram/updates webhook call (routes/telegram.py). Required
# at startup (validate_config()) -- without it the webhook accepts unauthenticated
# requests. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# Telegram webhook registration (routes/telegram.py). Optional -- only needed
# if using webhook mode instead of the poller thread.
# WEBHOOK_URL=https://your-domain.example.com
WEBHOOK_PATH=/telegram/updates

# Cooldown (seconds) between repeated Telegram alerts for the SAME scheduler
# job_id crashing repeatedly (EVENT_JOB_ERROR listener, scheduler/__init__.py).
# First failure always alerts regardless of this value. Default 1h.
SCHEDULER_JOB_ERROR_COOLDOWN_S=3600

# --- Feature flags (shadow/enforce pattern -- see CLAUDE.md) ---
# Composite edge-score veto pipeline: off (default) | shadow | enforce
EDGE_SCORE_MODE=off
# sectors.app overlay on sector verdicts: off (default) | shadow | enforce
SECTORS_APP_MODE=off

# --- Stockbit credentials (auto_token.py headless login + token refresh) ---
# Required for auto_token.py to run; without these, token refresh must be
# done manually. See docs/audit/STOCKBIT_TOKEN_REFRESH_HARDENING.md.
STOCKBIT_USER=your_email@example.com
STOCKBIT_PASS=your_stockbit_password_here
STOCKBIT_TOKEN_REFRESH_MARGIN_HOURS=14
STOCKBIT_TOKEN_REFRESH_MAX_RETRIES=2
STOCKBIT_TOKEN_REFRESH_BACKOFF_BASE_S=5
# Browser profile/session state directory for the headless login flow.
# DS_STATE_DIR=~/DS/.browser_agent_state

# Agent firm LLM providers
# Z.ai (OpenAI-compatible endpoint)
ZAI_API_KEY=your_zai_api_key_here
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# ZAI_API_KEY/ZAI_BASE_URL also honor the legacy DEEPSEEK_API_KEY/
# DEEPSEEK_BASE_URL names as a deprecated fallback (logs a warning) --
# rename to ZAI_* rather than setting the DEEPSEEK_* names.
AGENT_FIRM_MODEL=glm-5.2
AGENT_FIRM_ENABLED=true
# enforce mode: firm vetoes actually block trades (vs. observe-only). off by
# default -- see AGENT_FIRM_ENABLED/AUTH_MODE-style shadow/enforce pattern.
AGENT_FIRM_ENFORCE=false
# Daily USD spend cap across all provider calls; exceeding it fails open
# (firm disables itself for the rest of the day, alerts).
AGENT_FIRM_DAILY_CAP=5.0
# Kill-switch: firm treats itself as disabled whenever this file exists,
# regardless of AGENT_FIRM_ENABLED. Manual incident-response lever.
AGENT_FIRM_KILL_FILE=/tmp/agent_firm.disable
# Per-1M-token cost basis for spend-cap accounting (provider list pricing).
AGENT_FIRM_PRICE_IN=0.435
AGENT_FIRM_PRICE_OUT=0.870
# Per-agent (single LLM call) timeout, seconds.
AGENT_FIRM_AGENT_TIMEOUT=75
# Tavily web-search tool (used by news/research-context agents). Optional --
# agents degrade gracefully with no search results if unset.
TAVILY_API_KEY=
AGENT_FIRM_TAVILY_MAX=5
# ZAI concurrency cap -- the firm fans out with unbounded asyncio.gather();
# without this, a burst trips z.ai's 429 code 1302 rate limit.
AGENT_FIRM_ZAI_MAX_CONCURRENT=4

# Provider routing (claude | zai | auto)
AGENT_FIRM_PROVIDER=zai
AGENT_FIRM_PROVIDER_ORDER=claude,zai   # only used when AGENT_FIRM_PROVIDER=auto

# Claude (via Claude Code Subscription CLI — no API key needed)
AGENT_FIRM_CLAUDE_MODEL=sonnet
AGENT_FIRM_CLAUDE_MAX_CONCURRENT=4
AGENT_FIRM_CLAUDE_MAX_CALLS_PER_DAY=200
# Optional per-leg timeout overrides for the Claude CLI specifically (falls
# back to the generic AGENT_FIRM_*_TIMEOUT values below when unset).
# AGENT_FIRM_CLAUDE_CONNECTION_TIMEOUT=
# AGENT_FIRM_CLAUDE_READ_TIMEOUT=
# AGENT_FIRM_CLAUDE_OVERALL_TIMEOUT=

# Circuit breaker (per provider)
AGENT_FIRM_CIRCUIT_FAILURES=3
AGENT_FIRM_CIRCUIT_COOLDOWN=30

# Quota-aware routing (RCA 2026-07-10): hold a session-limited provider out
# of rotation until its advertised reset time instead of re-probing it every
# circuit cooldown. All optional; defaults shown.
AGENT_FIRM_QUOTA_HOLD=true
AGENT_FIRM_QUOTA_RESET_BUFFER=60       # s past the advertised reset before retrying
AGENT_FIRM_QUOTA_FALLBACK_HOLD=900     # s to hold when no reset time was parseable
AGENT_FIRM_QUOTA_MAX_HOLD=21600        # s cap on any hold (mis-parse safety)
AGENT_FIRM_QUOTA_ALERTS=true
AGENT_FIRM_ALERT_MIN_INTERVAL=1800     # s dedupe window for repeatable alerts
AGENT_FIRM_QUOTA_REPEAT_THRESHOLD=3    # limit hits without recovery -> escalation alert

# Adaptive provider governor (R-7 Tier 1): process-singleton AIMD controller
# that paces per-provider request ISSUE RATE, fixing z.ai HTTP 429 code 1302
# bursts a per-tick-rebuilt token bucket couldn't prevent. Enabled by default
# for zai only (Claude's constraint is the subscription window already
# handled by the quota-hold settings above). Defaults mirror the tuned
# values validated by scripts/replay_governor_ab.py's A/B replay.
AGENT_FIRM_GOVERNOR_ENABLED=true
AGENT_FIRM_GOVERNOR_PROVIDERS=zai
AGENT_FIRM_GOVERNOR_RATE_MAX=3.0        # req/s ceiling (also the starting rate)
AGENT_FIRM_GOVERNOR_RATE_MIN=0.5        # req/s floor after repeated 429s
AGENT_FIRM_GOVERNOR_BURST=3.0           # token-bucket burst capacity
AGENT_FIRM_GOVERNOR_AI_STEP=0.5         # additive-increase step, req/s
AGENT_FIRM_GOVERNOR_AI_INTERVAL_S=10.0  # min seconds between additive increases
AGENT_FIRM_GOVERNOR_MD_FACTOR=0.5       # multiplicative-decrease factor on a 429
AGENT_FIRM_GOVERNOR_POST_DECREASE_COOLDOWN_S=30.0  # no increase within this long after a decrease

# Timeouts (seconds) — generic defaults; AGENT_FIRM_CLAUDE_* overrides optional
AGENT_FIRM_CONNECTION_TIMEOUT=10
AGENT_FIRM_READ_TIMEOUT=60
AGENT_FIRM_OVERALL_TIMEOUT=75

# Backups (scripts/db_backup.py, nightly via deploy/crontab)
# BACKUP_DIR=~/backups/idx-walkforward-5001

# --- Route authentication (security hardening) ---
# off (default, legacy) | shadow (log-only) | enforce (fail closed)
AUTH_MODE=off
# Comma-separated token lists per role; >=16 chars each. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AUTH_TOKEN_ADMIN=
AUTH_TOKEN_OPERATOR=
AUTH_TOKEN_VIEWER=
AUTH_TOKEN_SCHEDULER=

# --- Release deployment (scripts/release.sh / scripts/rollback.sh) ---
# These are shell-invocation-time overrides for the release scripts, not
# .env-loaded application config (the scripts don't read .env) -- listed
# here only as a discoverable reference to their defaults.
# RELEASES_DIR=~/releases/idx-walkforward
# CURRENT_LINK=~/idx-walkforward-current
# SHARED_PATHS=".env venv logs walkforward.db flow.db idx_data.db .stockbit_token"
# ALLOW_DIRTY_RELEASE=1   # escape hatch for a one-off manual build; never for a real deploy
