# IDX Walkforward — canonical crontab (hardening Phase 4).
# THIS FILE IS THE SOURCE OF TRUTH — edit here, then install with:
#   crontab deploy/crontab
#
# Every job runs through scripts/cron_wrap.sh: per-job log in logs/cron_<job>.log
# plus a Telegram alert on ANY nonzero exit (missing script included).
# All paths use the no-space symlink /home/tjiesar/idx-walkforward-5001
# (the venv console-script shebangs break on the real "10 Projects" path).
#
# Removed 2026-07-10 (audit P-4 — scripts never existed in git, failing every
# run for weeks):
#   0 19 * * 1-5  sectors_fetcher.py   (sectors_* tables are stale since removal
#                                       of the script; sectors.app overlay is
#                                       shadow-only so no trade impact)
#   0  9 * * 1-5  audit_signals.py
#
# m h dom mon dow  command
D=/home/tjiesar/idx-walkforward-5001
W=/home/tjiesar/idx-walkforward-5001/scripts/cron_wrap.sh

# Stockbit token refresh (24h JWT) — pre-market
40 8 * * 1-5 cd $D && $W auto_token venv/bin/python3 auto_token.py

# OHLCV fetch — pre-market
50 8 * * 1-5 cd $D && $W stockbit_ohlcv sh -c 'venv/bin/python3 stockbit_fetcher.py --token "$(cat .stockbit_token)"'

# Flow fetch (EOD) — 18:30, after the APScheduler 16:05 run finishes (~16:25)
30 18 * * 1-5 cd $D && $W stockbit_flow sh -c 'venv/bin/python3 stockbit_fetcher.py flow --token "$(cat .stockbit_token)"'

# Scheduler heartbeat watchdog (dead-man's-switch, audit 3.7)
*/10 * * * * cd $D && $W heartbeat_check venv/bin/python3 scripts/check_scheduler_heartbeat.py

# Research (M3: off the production scheduler)
5 16 * * 5   cd $D && $W research_wf_refresh venv/bin/python3 -m research.cli wf-refresh
# Rule-parity walk-forward (audit 2026-09-02, finding L-1): the SAME study with the
# weekly-MTF gate production actually applies, written to wf_edge_rule keyed by
# rule_id. engine/admission.py will not admit a gated strategy on any other
# evidence, and refuses evidence older than WF_EDGE_MAX_AGE_DAYS (14), so this must
# run at least as often as that window. Saturday 06:00 — after Friday's wf-refresh
# has finished (that job runs ~2.5h from 16:05) and clear of every weekday job;
# the run itself takes several hours over the full 959-ticker corpus.
0 6 * * 6    cd $D && $W research_wf_parity venv/bin/python3 -m research.cli wf-parity
15 8 * * 1-5 cd $D && $W research_backtest_cache venv/bin/python3 -m research.cli backtest-cache
# Monthly window roller — FIRST SUNDAY only (audit R-9). Vanilla cron ORs dom+dow,
# so the old "0 10 1-7 * 0" fired every day 1-7 AND every Sunday (~11x/month).
# Fix: restrict day-of-month to the first week (1-7) with dow=* (single field
# restricted => no OR), then guard to Sunday via date +%u == 7 => exactly the
# first Sunday. Roller only appends windows, so the old over-firing was wasteful
# not harmful; this makes cadence match the documented monthly intent.
0 10 1-7 * * [ "$(date +\%u)" = "7" ] && cd $D && $W research_roller venv/bin/python3 -m research.cli roller

# Forward test FWD-PM-VOLEX-001 (opened 2026-09-16) -- volatility-exclusion rule.
# Weekly, not monthly, on purpose: the script's own calendar-month guard allows at
# most ONE formation per month, while the scorer needs to run often so matured
# formations (entry +21 sessions) are scored promptly rather than up to a month late.
# Research-side only: reads ohlcv read-only, writes just its own append-only ledger.
# Protocol + frozen spec: docs/research_programs/P-M/forward_exclusion/PROTOCOL.md
30 7 * * 1   cd $D && $W research_fwd_volex venv/bin/python3 docs/research_programs/P-M/forward_exclusion/run_forward.py

# Nightly DB backup (walkforward.db + research.db) and the weekly restore
# drill moved OFF cron to systemd --user timers on 2026-08-15 (P2-6):
# vanilla cron has no catch-up semantics, so a fire time missed while this
# box (a laptop that suspends/reboots on its own schedule) was asleep is
# silently skipped, not retried -- exactly what caused the weekly drill to
# go 27 days (2026-07-19 to 2026-08-15) without actually running.
# Source of truth: deploy/systemd/ (README.md has install/verify/uninstall).
# The dead-man's-switch below is unaffected -- it reads the same
# cron_wrap.sh log files regardless of which trigger wrote them.

# Backup/restore-drill dead-man's-switch (P1-2): cron_wrap.sh alerts on a job
# firing and FAILING, but not on a job silently never firing at all (a ~36h
# backup gap already happened once, 2026-07-25/26, and went undetected until
# manually noticed). Checks the three jobs above's own cron_wrap.sh log mtimes.
0 7 * * * cd $D && $W backup_heartbeat_check venv/bin/python3 scripts/check_backup_heartbeat.py

# OHLCV finalisation dead-man's-switch (2026-09-16). The 16:15 EOD scraper
# writes is_final=1; when it does not complete, that session's intraday bars
# stay is_final=0 FOREVER and every research query (which filters is_final=1)
# silently sees ~135 of ~915 tickers instead of failing. Five such sessions had
# accumulated undetected -- cron_wrap.sh only alerts on a job that fired and
# FAILED, and the partial EOD run exits 0. Also flags THIN sessions whose bars
# were never fetched at all (2026-07-09, 2026-07-24).
# Repair a stranded session with: scripts/repair_provisional_bars.py --apply
0 9 * * * cd $D && $W provisional_bars_check venv/bin/python3 scripts/check_provisional_bars.py

# Issuance ex-date monitor (D-064 §D): alerts once when a recorded forward-test
# window (REGIME/FADE hold, VOLEX hold) spans a rights/bonus/reverse-split
# ex-date -- research prices are split-adjusted only, so such a window carries a
# mechanical price step. Detection only; never edits a ledger. After the 09:30
# regime and 09:35 fade recorders so their fresh appends are covered.
45 9 * * 1-5 cd $D && $W issuance_windows_check venv/bin/python3 scripts/check_issuance_windows.py

# FWD-PM-REGIME-001 forward test (HYP-PM-0010, family P-M Price-Trend {T1}),
# opened 2026-09-17. Appends CLOSED trades to
# docs/research_programs/P-M/forward_regime/ledger.json. Read-only against the
# DB. Never back-fills: entries dated before opened_utc are refused, because
# replaying the backtest would turn in-sample discovery into an apparent
# forward record. Runs after the 16:15 EOD is_final=1 write and after the
# 09:00 provisional-bars dead-man's-switch, so a stranded session is flagged
# before it can be silently recorded as a formation.
30 9 * * * cd $D && $W fwd_regime_formation venv/bin/python3 docs/research_programs/P-M/forward_regime/run_formation.py

# FWD-PM-FADE-001 forward test (HYP-PM-0012, family P-M Price-Reversal {R1}),
# opened 2026-09-21 (D-052). Appends a signal to
# docs/research_programs/P-M/forward_fade/ledger.json only when its h=20 leg
# closes; read-only against the DB; refuses back-fill (signals dated before
# opened_utc). Runs after the 09:30 regime recorder. Was installed live since
# d73db17 but missing here until 2026-09-30 (installed/deploy drift).
35 9 * * * cd $D && $W fwd_fade_recorder venv/bin/python3 docs/research_programs/P-M/forward_fade/run_recorder.py

# FWD-PM-BANK-001 forward test (HYP-PM-0014, family P-M Price-Reversal {R1,R2}),
# opened 2026-10-05 (D-066). Appends a big-4 bank 2-ATR climax-low event to
# docs/research_programs/P-M/forward_bank/ledger.json only when its 10-session
# window closes with every leg present; read-only against the DB; refuses back-fill.
40 9 * * * cd $D && $W fwd_bank_recorder venv/bin/python3 docs/research_programs/P-M/forward_bank/run_recorder.py
